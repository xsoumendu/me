---
import { resume } from '../data/resume';
---

<section class="section skills" id="skills">
  <div class="section-inner">
    <p class="section-label">Technical repertoire</p>
    <h2 class="section-heading">From governed cloud platforms to AI-native products.</h2>
    <div class="skills__grid">
      {resume.skills.map((group) => (
        <article class="skills__group">
          <h3>{group.label}</h3>
          <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills { background: var(--ink); color: var(--surface); }
  .skills :global(.section-label) { color: var(--lime); }
  .skills__grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #4c5956; border-left: 1px solid #4c5956; }
  .skills__group { min-height: 220px; padding: 1.6rem; border-right: 1px solid #4c5956; border-bottom: 1px solid #4c5956; }
  .skills__group:nth-child(2n) { background: #1d3430; }
  .skills__group h3 { margin-bottom: 1.25rem; color: var(--lime); font-size: 1.3rem; }
  .skills__group ul { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
  .skills__group li { padding: 0.22rem 0.44rem; border: 1px solid #4c5956; color: #dce5de; font-size: 0.78rem; }
  @media (max-width: 850px) { .skills__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 550px) { .skills__grid { grid-template-columns: 1fr; } .skills__group { min-height: unset; } }
</style>