---
import { resume } from '../data/resume';
---

<section class="section engagements" id="engagements">
  <div class="section-inner">
    <p class="section-label">Selected engagements</p>
    <h2 class="section-heading">Complex, regulated work delivered end to end.</h2>
    <div class="engagements__list">
      {resume.engagements.map((engagement, index) => (
        <article class="engagement">
          <div class="engagement__number">0{index + 1}</div>
          <div>
            <p class="engagement__period">{engagement.period}</p>
            <h3>{engagement.title}</h3>
            <p class="engagement__role">{engagement.role}</p>
          </div>
          <div class="engagement__detail">
            <p class="engagement__stack"><strong>Stack</strong> {engagement.stack}</p>
            <ul>{engagement.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .engagements { background: #dfe7dc; }
  .engagements__list { border-top: 1px solid #afbaad; }
  .engagement { display: grid; grid-template-columns: 72px minmax(220px, 0.66fr) minmax(0, 1fr); gap: 1.6rem; padding: 2.2rem 0; border-bottom: 1px solid #afbaad; }
  .engagement__number { color: var(--coral); font-family: var(--display); font-size: 2rem; font-weight: 900; }
  .engagement__period { margin-bottom: 0.4rem; color: var(--teal); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; }
  .engagement h3 { margin-bottom: 0.45rem; font-size: clamp(1.55rem, 2.8vw, 2.35rem); }
  .engagement__role { margin-bottom: 0; color: var(--muted); font-weight: 700; }
  .engagement__stack { margin-bottom: 1rem; color: var(--muted); font-size: 0.9rem; }
  .engagement__stack strong { color: var(--ink); }
  .engagement ul { display: grid; gap: 0.55rem; margin: 0; padding-left: 1.1rem; }
  .engagement li::marker { color: var(--coral); }
  @media (max-width: 760px) { .engagement { grid-template-columns: 42px 1fr; gap: 0.9rem; } .engagement__detail { grid-column: 2; } }
</style>