---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Soumendu Nandi | Solution Architect',
  description = 'Data and Generative AI product engineering and architecture.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #14211f;
    --muted: #53605c;
    --paper: #f4f0e8;
    --surface: #fffdf8;
    --line: #d9d5ca;
    --teal: #0a7168;
    --coral: #e76252;
    --lime: #c8d94d;
    --display: 'Avenir Next', 'Trebuchet MS', sans-serif;
    --body: 'Avenir Next', 'Trebuchet MS', sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--body);
    line-height: 1.55;
  }
  a { color: inherit; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { font-family: var(--display); line-height: 1.04; }
  .page-shell { overflow: hidden; }
  .section { padding: 6.5rem 1.5rem; }
  .section-inner { width: min(1120px, 100%); margin: 0 auto; }
  .section-label {
    margin-bottom: 0.8rem;
    color: var(--teal);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .section-heading { max-width: 700px; margin-bottom: 2.6rem; font-size: clamp(2rem, 5vw, 4.2rem); }
  .eyebrow { color: var(--teal); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }
  .button:hover { background: var(--teal); border-color: var(--teal); transform: translateY(-2px); }
  .button--quiet { background: transparent; color: var(--ink); }
  .button--quiet:hover { background: var(--lime); border-color: var(--lime); color: var(--ink); }
  @media (max-width: 700px) {
    .section { padding: 4.5rem 1.15rem; }
    .section-heading { margin-bottom: 2rem; }
  }
</style>